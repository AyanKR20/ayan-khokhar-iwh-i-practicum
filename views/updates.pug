doctype html
html
  head
    title Add Character
  body
    h1 Add a New Character
    form(action="/update-cobj" method="POST")
      label(for="name") Name:
      input(type="text" name="name" required)
      br
      label(for="race") race:
      input(type="text" name="race" required)
      br
      label(for="birth_place") birth_place:
      input(type="text" name="birth_place" required)
      br
      button(type="submit") Submit
